{
  "enabledPlugins": {
    "serena@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_serena_serena__get_symbols_overview",
      "mcp__plugin_serena_serena__find_symbol",
      "mcp__plugin_serena_serena__find_referencing_symbols",
      "mcp__plugin_serena_serena__find_implementations",
      "mcp__plugin_serena_serena__find_declaration",
      "mcp__plugin_serena_serena__search_for_pattern",
      "mcp__plugin_serena_serena__list_dir",
      "mcp__plugin_serena_serena__find_file",
      "mcp__plugin_serena_serena__read_file",
      "mcp__plugin_serena_serena__list_memories",
      "mcp__plugin_serena_serena__read_memory",
      "mcp__plugin_serena_serena__write_memory",
      "mcp__plugin_serena_serena__get_diagnostics_for_file",
      "Bash(source venv/bin/activate*)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(black *)",
      "Bash(pylint *)",
      "Bash(mypy*)",
      "Bash(pip install -e*)",
      "Bash(mkdocs build*)",
      "Bash(pip show*)",
      "Bash(pip list*)",
      "Bash(pip freeze*)"
    ],
    "deny": [
      "EnterWorktree",
      "Bash(git worktree *)",
      "Bash(git commit*)",
      "Bash(git commit:*)",
      "Bash(git push*)",
      "Bash(git push:*)",
      "Bash(git tag*)",
      "Bash(git-cliff*)",
      "Bash(twine*)",
      "Bash(python -m twine*)",
      "Bash(mkdocs gh-deploy*)",
      "Bash(gh release*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Read the serena memories (.serena/memories/) and .ai/ logs before starting work; update them before finishing — see AGENTS.md.'",
            "statusMessage": "Reminding to read project memories"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai-tracking-reminder.sh\"",
            "statusMessage": "Checking .ai/ tracking is up to date"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  }
}
